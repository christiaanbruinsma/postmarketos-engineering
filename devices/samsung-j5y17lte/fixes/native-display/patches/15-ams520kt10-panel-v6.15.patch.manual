--- a/drivers/gpu/drm/panel/Kconfig
+++ b/drivers/gpu/drm/panel/Kconfig
@@ -775,6 +775,15 @@
 	select DRM_MIPI_DSI
 	select VIDEOMODE_HELPERS
 
+config DRM_PANEL_SAMSUNG_S6E8AA5X01_AMS520KT10
+	tristate "Samsung AMS520KT10 panel with S6E8AA5X01 controller"
+	depends on GPIOLIB && OF && REGULATOR
+	depends on DRM_MIPI_DSI
+	help
+	  Say Y here if you want to enable support for Samsung AMS520KT10
+	  panel, which uses Samsung's S6E8AA5X01 controller. The panel has a
+	  720x1280 AMOLED display driven by the MIPI DSI protocol with 4 lanes.
+
 config DRM_PANEL_SAMSUNG_S6E8AA5X01_AMS561RA01
 	tristate "Samsung AMS561RA01 panel with S6E8AA5X01 controller"
 	depends on GPIOLIB && OF && REGULATOR
--- a/drivers/gpu/drm/panel/Makefile
+++ b/drivers/gpu/drm/panel/Makefile
@@ -81,6 +81,7 @@
 obj-$(CONFIG_DRM_PANEL_SAMSUNG_S6E88A0_AMS427AP24) += panel-samsung-s6e88a0-ams427ap24.o
 obj-$(CONFIG_DRM_PANEL_SAMSUNG_S6E88A0_AMS452EF01) += panel-samsung-s6e88a0-ams452ef01.o
 obj-$(CONFIG_DRM_PANEL_SAMSUNG_S6E8AA0) += panel-samsung-s6e8aa0.o
+obj-$(CONFIG_DRM_PANEL_SAMSUNG_S6E8AA5X01_AMS520KT10) += panel-samsung-s6e8aa5x01-ams520kt10.o
 obj-$(CONFIG_DRM_PANEL_SAMSUNG_S6E8AA5X01_AMS561RA01) += panel-samsung-s6e8aa5x01-ams561ra01.o
 obj-$(CONFIG_DRM_PANEL_SAMSUNG_SOFEF00) += panel-samsung-sofef00.o
 obj-$(CONFIG_DRM_PANEL_SEIKO_43WVF1G) += panel-seiko-43wvf1g.o
--- a/drivers/gpu/drm/panel/panel-samsung-s6e8aa5x01-ams520kt10.c
+++ b/drivers/gpu/drm/panel/panel-samsung-s6e8aa5x01-ams520kt10.c
@@ -0,0 +1,264 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Samsung AMS520KT10 panel with S6E8AA5X01 controller.
+ */
+
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/regulator/consumer.h>
+
+#include <drm/drm_mipi_dsi.h>
+#include <drm/drm_modes.h>
+#include <drm/drm_panel.h>
+#include <drm/drm_probe_helper.h>
+
+/* Manufacturer Command Set */
+#define MCS_GLOBAL_PARAM	0xb0
+#define MCS_DE_DIM		0xb8
+#define MCS_PENTILE		0xc0
+#define MCS_PCD			0xcc
+#define MCS_ERRFLAG		0xe7
+#define MCS_ACCESSPROT		0xf0
+
+struct s6e8aa5x01_ams520kt10_ctx {
+	struct drm_panel panel;
+	struct mipi_dsi_device *dsi;
+	struct gpio_desc *reset_gpio;
+	struct regulator *lcd_3p0;
+	struct regulator *lcd_1p8;
+};
+
+static inline struct s6e8aa5x01_ams520kt10_ctx *
+to_ctx(struct drm_panel *panel)
+{
+	return container_of(panel, struct s6e8aa5x01_ams520kt10_ctx, panel);
+}
+
+static int s6e8aa5x01_ams520kt10_prepare(struct drm_panel *panel)
+{
+	struct s6e8aa5x01_ams520kt10_ctx *ctx = to_ctx(panel);
+	struct device *dev = &ctx->dsi->dev;
+	int ret;
+
+	/*
+	 * J5Y17 power-up order:
+	 * LCD_3P0 -> LCD_1P8 -> 5-6 ms -> reset sequence.
+	 */
+	ret = regulator_enable(ctx->lcd_3p0);
+	if (ret < 0)
+		return dev_err_probe(dev, ret, "failed to enable LCD_3P0\n");
+
+	ret = regulator_enable(ctx->lcd_1p8);
+	if (ret < 0) {
+		regulator_disable(ctx->lcd_3p0);
+		return dev_err_probe(dev, ret, "failed to enable LCD_1P8\n");
+	}
+
+	usleep_range(5000, 6000);
+
+	/*
+	 * reset-gpios is active-low. Logical values therefore produce:
+	 *
+	 *   0 -> physical HIGH
+	 *   1 -> physical LOW
+	 *   0 -> physical HIGH
+	 */
+	gpiod_set_value_cansleep(ctx->reset_gpio, 0);
+	usleep_range(5000, 6000);
+
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	usleep_range(5000, 6000);
+
+	gpiod_set_value_cansleep(ctx->reset_gpio, 0);
+	usleep_range(10000, 11000);
+
+	return 0;
+}
+
+static int s6e8aa5x01_ams520kt10_unprepare(struct drm_panel *panel)
+{
+	struct s6e8aa5x01_ams520kt10_ctx *ctx = to_ctx(panel);
+	struct device *dev = &ctx->dsi->dev;
+	int ret, ret_3p0;
+
+	/*
+	 * J5Y17 power-down order:
+	 * reset LOW -> 10-11 ms -> LCD_1P8 off -> LCD_3P0 off.
+	 */
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	usleep_range(10000, 11000);
+
+	ret = regulator_disable(ctx->lcd_1p8);
+	if (ret < 0)
+		dev_err(dev, "failed to disable LCD_1P8: %d\n", ret);
+
+	ret_3p0 = regulator_disable(ctx->lcd_3p0);
+	if (ret_3p0 < 0)
+		dev_err(dev, "failed to disable LCD_3P0: %d\n", ret_3p0);
+
+	if (ret < 0)
+		return ret;
+
+	return ret_3p0;
+}
+
+static int s6e8aa5x01_ams520kt10_enable(struct drm_panel *panel)
+{
+	struct s6e8aa5x01_ams520kt10_ctx *ctx = to_ctx(panel);
+	struct mipi_dsi_multi_context dsi = { .dsi = ctx->dsi };
+
+	/* Downstream J5Y17 init begins with an additional 5-6 ms delay. */
+	usleep_range(5000, 6000);
+
+	mipi_dsi_dcs_write_seq_multi(&dsi, MCS_ACCESSPROT, 0x5a, 0x5a);
+
+	mipi_dsi_dcs_exit_sleep_mode_multi(&dsi);
+	mipi_dsi_msleep(&dsi, 20);
+
+	/*
+	 * Downstream enables the F0 test key again after sleep-out.
+	 * Preserve that proven sequence even though the ID read and
+	 * brightness/calibration pipeline are intentionally omitted here.
+	 */
+	mipi_dsi_dcs_write_seq_multi(&dsi, MCS_ACCESSPROT, 0x5a, 0x5a);
+
+	mipi_dsi_dcs_write_seq_multi(&dsi, MCS_PENTILE,
+				     0xd8, 0xd8, 0x40);
+	mipi_dsi_dcs_write_seq_multi(&dsi, MCS_GLOBAL_PARAM, 0x06);
+	mipi_dsi_dcs_write_seq_multi(&dsi, MCS_DE_DIM, 0xa8);
+	mipi_dsi_dcs_write_seq_multi(&dsi, MCS_PCD, 0x4c);
+	mipi_dsi_dcs_write_seq_multi(&dsi, MCS_ERRFLAG,
+				     0xed, 0xc7, 0x23, 0x67);
+
+	mipi_dsi_msleep(&dsi, 120);
+
+	mipi_dsi_dcs_write_seq_multi(&dsi, MCS_ACCESSPROT, 0xa5, 0xa5);
+
+	mipi_dsi_dcs_set_display_on_multi(&dsi);
+
+	return dsi.accum_err;
+}
+
+static int s6e8aa5x01_ams520kt10_disable(struct drm_panel *panel)
+{
+	struct s6e8aa5x01_ams520kt10_ctx *ctx = to_ctx(panel);
+	struct mipi_dsi_multi_context dsi = { .dsi = ctx->dsi };
+
+	mipi_dsi_dcs_set_display_off_multi(&dsi);
+	mipi_dsi_dcs_enter_sleep_mode_multi(&dsi);
+	mipi_dsi_msleep(&dsi, 120);
+
+	return dsi.accum_err;
+}
+
+static const struct drm_display_mode s6e8aa5x01_ams520kt10_mode = {
+	.clock = (720 + 130 + 20 + 60) * (1280 + 14 + 2 + 8) * 60 / 1000,
+
+	.hdisplay = 720,
+	.hsync_start = 720 + 130,
+	.hsync_end = 720 + 130 + 20,
+	.htotal = 720 + 130 + 20 + 60,
+
+	.vdisplay = 1280,
+	.vsync_start = 1280 + 14,
+	.vsync_end = 1280 + 14 + 2,
+	.vtotal = 1280 + 14 + 2 + 8,
+
+	.width_mm = 65,
+	.height_mm = 115,
+
+	.type = DRM_MODE_TYPE_DRIVER | DRM_MODE_TYPE_PREFERRED,
+};
+
+static int s6e8aa5x01_ams520kt10_get_modes(struct drm_panel *panel,
+					   struct drm_connector *connector)
+{
+	return drm_connector_helper_get_modes_fixed(
+		connector, &s6e8aa5x01_ams520kt10_mode);
+}
+
+static const struct drm_panel_funcs s6e8aa5x01_ams520kt10_panel_funcs = {
+	.prepare = s6e8aa5x01_ams520kt10_prepare,
+	.unprepare = s6e8aa5x01_ams520kt10_unprepare,
+	.enable = s6e8aa5x01_ams520kt10_enable,
+	.disable = s6e8aa5x01_ams520kt10_disable,
+	.get_modes = s6e8aa5x01_ams520kt10_get_modes,
+};
+
+static int s6e8aa5x01_ams520kt10_probe(struct mipi_dsi_device *dsi)
+{
+	struct device *dev = &dsi->dev;
+	struct s6e8aa5x01_ams520kt10_ctx *ctx;
+	int ret;
+
+	ctx = devm_kzalloc(dev, sizeof(*ctx), GFP_KERNEL);
+	if (!ctx)
+		return -ENOMEM;
+
+	drm_panel_init(&ctx->panel, dev,
+		       &s6e8aa5x01_ams520kt10_panel_funcs,
+		       DRM_MODE_CONNECTOR_DSI);
+
+	ctx->dsi = dsi;
+	mipi_dsi_set_drvdata(dsi, ctx);
+
+	ctx->lcd_3p0 = devm_regulator_get(dev, "lcd-3p0");
+	if (IS_ERR(ctx->lcd_3p0))
+		return dev_err_probe(dev, PTR_ERR(ctx->lcd_3p0),
+				     "failed to get LCD_3P0 regulator\n");
+
+	ctx->lcd_1p8 = devm_regulator_get(dev, "lcd-1p8");
+	if (IS_ERR(ctx->lcd_1p8))
+		return dev_err_probe(dev, PTR_ERR(ctx->lcd_1p8),
+				     "failed to get LCD_1P8 regulator\n");
+
+	ctx->reset_gpio = devm_gpiod_get(dev, "reset", GPIOD_ASIS);
+	if (IS_ERR(ctx->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(ctx->reset_gpio),
+				     "failed to get reset-gpios\n");
+
+	dsi->lanes = 4;
+	dsi->format = MIPI_DSI_FMT_RGB888;
+	dsi->mode_flags = MIPI_DSI_MODE_VIDEO |
+			  MIPI_DSI_MODE_VIDEO_BURST |
+			  MIPI_DSI_MODE_VIDEO_NO_HFP;
+
+	ctx->panel.prepare_prev_first = true;
+	drm_panel_add(&ctx->panel);
+
+	ret = devm_mipi_dsi_attach(dev, dsi);
+	if (ret < 0) {
+		drm_panel_remove(&ctx->panel);
+		return dev_err_probe(dev, ret, "failed to attach to DSI host\n");
+	}
+
+	return 0;
+}
+
+static void s6e8aa5x01_ams520kt10_remove(struct mipi_dsi_device *dsi)
+{
+	struct s6e8aa5x01_ams520kt10_ctx *ctx = mipi_dsi_get_drvdata(dsi);
+
+	drm_panel_remove(&ctx->panel);
+}
+
+static const struct of_device_id s6e8aa5x01_ams520kt10_of_device_id[] = {
+	{ .compatible = "samsung,s6e8aa5x01-ams520kt10" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, s6e8aa5x01_ams520kt10_of_device_id);
+
+static struct mipi_dsi_driver s6e8aa5x01_ams520kt10_dsi_driver = {
+	.probe = s6e8aa5x01_ams520kt10_probe,
+	.remove = s6e8aa5x01_ams520kt10_remove,
+	.driver = {
+		.name = "panel-samsung-s6e8aa5x01-ams520kt10",
+		.of_match_table = s6e8aa5x01_ams520kt10_of_device_id,
+	},
+};
+module_mipi_dsi_driver(s6e8aa5x01_ams520kt10_dsi_driver);
+
+MODULE_DESCRIPTION("Samsung AMS520KT10 AMOLED panel driver");
+MODULE_LICENSE("GPL");
