--- a/arch/arm64/boot/dts/exynos/exynos7870-j5y17lte.dts
+++ b/arch/arm64/boot/dts/exynos/exynos7870-j5y17lte.dts
@@ -305,16 +305,12 @@
 				regulator-name = "vdd_ldo29";
 				regulator-min-microvolt = <3000000>;
 				regulator-max-microvolt = <3000000>;
-				regulator-boot-on;
-				regulator-always-on;
 			};
 
 			vdd_ldo30: ldo30 {
 				regulator-name = "vdd_ldo30";
 				regulator-min-microvolt = <1800000>;
 				regulator-max-microvolt = <1800000>;
-				regulator-boot-on;
-				regulator-always-on;
 			};
 
 			vdd_ldo31: ldo31 {
@@ -543,6 +539,27 @@
 	status = "okay";
 };
 
+&decon {
+	status = "okay";
+};
+
+&dsi {
+	#address-cells = <1>;
+	#size-cells = <0>;
+
+	status = "okay";
+
+	panel@0 {
+		compatible = "samsung,s6e8aa5x01-ams520kt10";
+		reg = <0>;
+
+		reset-gpios = <&gpd3 4 GPIO_ACTIVE_LOW>;
+
+		lcd-3p0-supply = <&vdd_ldo29>;
+		lcd-1p8-supply = <&vdd_ldo30>;
+	};
+};
+
 &usbdrd {
 	vdd33-supply = <&vdd_ldo8>;
 
